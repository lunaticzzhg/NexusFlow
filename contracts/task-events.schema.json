{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventVersion", "taskId", "tenantId", "type", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "eventVersion": {"type": "integer", "minimum": 1},
    "taskId": {"type": "string", "minLength": 1},
    "tenantId": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["TASK_CREATED", "CONTEXT_GATHERING_STARTED", "CONTEXT_GATHERED", "PLAN_GENERATION_STARTED", "PLAN_PROPOSED", "APPROVAL_REQUIRED", "APPROVAL_DECIDED", "EXECUTION_STARTED", "TASK_COMPLETED", "RETRY_SCHEDULED", "TASK_FAILED", "TASK_CANCELLED"]},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "minLength": 1},
    "causationId": {"type": "string"},
    "payload": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}

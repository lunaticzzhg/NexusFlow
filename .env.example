# Copy to .env for local development. Keep real secrets only in ignored local env files or a secret manager.

# Compose dependencies
# Local-only Postgres defaults used by docker-compose and Gradle-launched backend runs.
POSTGRES_DB=nexusflow
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev
POSTGRES_HOST_PORT=5432
# Redis defaults. Use REDIS_INTERNAL_URL only from another Compose service.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379
REDIS_INTERNAL_URL=redis://redis:6379/0
# Kafka-compatible Redpanda defaults. Use KAFKA_INTERNAL_BOOTSTRAP_SERVERS only from another Compose service.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_HOST_PORT=19092
REDPANDA_ADMIN_HOST_PORT=19644
PANDAPROXY_HOST_PORT=18082
# OpenTelemetry OTLP endpoints. Use OTEL_INTERNAL_EXPORTER_OTLP_ENDPOINT only from another Compose service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INTERNAL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133

# Backend startup/auth
# Optional; accepted values: local, test, prod, production. Missing defaults to production runtime wiring.
ORBIT_RUNTIME_PROFILE=local
# Required backend database connection.
DATABASE_URL=jdbc:postgresql://localhost:5432/nexusflow
DATABASE_USER=nexusflow
DATABASE_PASSWORD=nexusflow_dev
# Required auth token settings. Do not commit real JWT keys.
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=nexusflow-api
AUTH_JWT_KEY_ID=local-auth-key
AUTH_JWT_PRIVATE_KEY_PEM_BASE64=
AUTH_JWT_PUBLIC_KEY_PEM_BASE64=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Required Google Web OAuth Client ID(s), comma-separated. Public client metadata, not a secret.
GOOGLE_ALLOWED_AUDIENCES=
# Optional; default false. If true, ORBIT_DEV_LOGIN_EMAIL and ORBIT_DEV_LOGIN_PASSWORD are required and nonblank.
ORBIT_DEV_LOGIN_ENABLED=false
ORBIT_DEV_LOGIN_EMAIL=dev@nexusflow.local
ORBIT_DEV_LOGIN_PASSWORD=

# AI
# Optional. Leave AI_PROVIDER blank to disable AI. Accepted providers: openai, qwen, deepseek.
AI_PROVIDER=
# Required only when AI_PROVIDER is nonblank. Do not commit a real key.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional typed settings; missing uses defaults, present blank/invalid fails.
AI_REQUEST_TIMEOUT_MS=90000
# AI_ENABLE_THINKING=false

# Response Run
# Optional typed settings; missing uses defaults, present blank/invalid fails.
RESPONSE_RUN_WORKER_ENABLED=false
RESPONSE_RUN_POLL_INTERVAL_MS=1000
RESPONSE_RUN_LEASE_DURATION_MS=30000
RESPONSE_RUN_HEARTBEAT_INTERVAL_MS=10000
RESPONSE_RUN_RETRY_BACKOFF_MS=5000
RESPONSE_RUN_MAX_ATTEMPTS=3
RESPONSE_RUN_WORKER_PARALLELISM=2
RESPONSE_RUN_MAX_DURATION_MS=1800000

# External sources
# Optional typed settings; missing uses defaults, present blank/invalid fails.
ORBIT_OPPORTUNITY_SOURCE_MODE=external
EXTERNAL_SOURCE_REQUEST_TIMEOUT_MS=8000
EXTERNAL_SOURCE_USER_AGENT=NexusFlow/0.1
# Optional API keys/tokens. Blank disables that source unless the source has a public fallback default.
TAVILY_API_KEY=
TMDB_API_READ_TOKEN=
OMDB_API_KEY=
API_FOOTBALL_KEY=
FOOTBALL_DATA_API_TOKEN=
TICKETMASTER_API_KEY=
THESPORTSDB_API_KEY=3
ORS_API_KEY=
# Optional source endpoint overrides. Blank uses the source default.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
THESPORTSDB_BASE_URL=https://www.thesportsdb.com
ORS_ROUTING_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODE_BASE_URL=https://api.heigit.org/pelias/v1
OVERPASS_BASE_URL=https://overpass-api.de/api
TRAILSPLITS_BASE_URL=https://api.trailsplits.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
MET_NO_BASE_URL=https://api.met.no
CHINA_OFFICIAL_CINEMA_PAGE_URLS=

# Logging
# Optional typed settings; missing uses defaults, present blank/invalid fails for APP_ENV, LOG_LEVEL, and LOG_FORMAT.
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=pretty
SERVICE_NAME=nexusflow-backend

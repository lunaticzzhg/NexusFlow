# Copy to .env for local development. All password defaults are local-only.
POSTGRES_DB=nexusflow
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev
POSTGRES_HOST_PORT=5432
# Defaults below are for Gradle-launched services on the host machine.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379
REDIS_INTERNAL_URL=redis://redis:6379/0

# Kafka-compatible Redpanda: use the INTERNAL value only from another Compose service.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_HOST_PORT=19092
REDPANDA_ADMIN_HOST_PORT=19644
PANDAPROXY_HOST_PORT=18082

# Keycloak development administration. Never use these values outside local development.
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ADMIN_USERNAME=orbit-admin
KEYCLOAK_ADMIN_PASSWORD=orbit-admin-dev-only
# Keep the issuer public and stable: it must match the `iss` claim seen by the KMP app.
OIDC_ISSUER_URI=http://localhost:8081/realms/orbit-local
OIDC_AUDIENCE=orbit-api

# OpenTelemetry OTLP endpoints: use the INTERNAL value only from another Compose service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INTERNAL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133
AI_PROVIDER=stub

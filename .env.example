# Copy to .env for local development. All password defaults are local-only.
POSTGRES_DB=nexusflow
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev
POSTGRES_HOST_PORT=5432
# Defaults below are for Gradle-launched services on the host machine.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379
REDIS_INTERNAL_URL=redis://redis:6379/0

# Kafka-compatible Redpanda: use the INTERNAL value only from another Compose service.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_HOST_PORT=19092
REDPANDA_ADMIN_HOST_PORT=19644
PANDAPROXY_HOST_PORT=18082

# Backend authentication. Do not commit actual private keys or database passwords.
ORBIT_RUNTIME_PROFILE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/nexusflow
DATABASE_USER=nexusflow
DATABASE_PASSWORD=nexusflow_dev
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=nexusflow-api
AUTH_JWT_KEY_ID=local-auth-key
AUTH_JWT_PRIVATE_KEY_PEM_BASE64=
AUTH_JWT_PUBLIC_KEY_PEM_BASE64=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Google Web OAuth Client ID(s), comma-separated. This is public client metadata, not a secret.
GOOGLE_ALLOWED_AUDIENCES=

# OpenTelemetry OTLP endpoints: use the INTERNAL value only from another Compose service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INTERNAL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133
AI_PROVIDER=stub
